#!/bin/sh

CURRENT_FILE="operating-system/CURRENT.md"

while read -r local_ref local_sha remote_ref remote_sha
do
    # Deleted branch/tag
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # New remote branch
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        changed_files=$(git diff-tree --no-commit-id --name-only -r "$local_sha")
    else
        changed_files=$(git diff --name-only "$remote_sha" "$local_sha")
    fi

    if printf '%s\n' "$changed_files" | grep -Fxq "$CURRENT_FILE"; then
        continue
    fi

    echo ""
    echo "=============================================="
    echo "  PUSH BLOCKED — Project Zero"
    echo "=============================================="
    echo ""
    echo "CURRENT.md was not updated in this push."
    echo ""
    echo "Before pushing, make Project Zero resumable:"
    echo ""
    echo "  - What did I complete?"
    echo "  - What did I learn?"
    echo "  - What decisions changed?"
    echo "  - What is the exact NEXT ACTION?"
    echo ""
    echo "Update:"
    echo "  $CURRENT_FILE"
    echo ""
    echo "Then commit and push again."
    echo ""

    exit 1
done

exit 0